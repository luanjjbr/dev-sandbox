<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <RootNamespace>DevSandbox.UI</RootNamespace>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- DPI explícito (lido por ApplicationConfiguration.Initialize no Program.cs).
         SystemAware = comportamento atual; os formulários usam AutoScaleMode.Font. -->
    <ApplicationHighDpiMode>SystemAware</ApplicationHighDpiMode>
    <ApplicationVisualStyles>true</ApplicationVisualStyles>
    <ApplicationDefaultFont>Segoe UI, 9pt</ApplicationDefaultFont>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\DevSandbox.Core\DevSandbox.Core.csproj" />
  </ItemGroup>

  <!-- Copia automaticamente os executáveis gerados para a pasta dist/ na raiz do projeto -->
  <Target Name="CopyToDist" AfterTargets="Build">
    <PropertyGroup>
      <DistDir>$([System.IO.Path]::GetFullPath('$(MSBuildProjectDirectory)\..\..\dist'))</DistDir>
    </PropertyGroup>
    <ItemGroup>
      <OutputFiles Include="$(TargetDir)**\*.*" />
    </ItemGroup>
    <Message Importance="high" Text="📦 [DevSandbox] Copiando executável para pasta de distribuição: $(DistDir)" />
    <Copy SourceFiles="@(OutputFiles)"
          DestinationFolder="$(DistDir)\%(RecursiveDir)"
          SkipUnchangedFiles="true" />
  </Target>

</Project>
